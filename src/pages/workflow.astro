---
import ThemeToggle from "../components/ThemeToggle.astro";
import { emailHref, site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { iconFor } from "../lib/projects";

type Tool = {
  name: string;
  use: string;
  icon?: string;
  image?: string;
  href: string;
  accent: string;
};

const dailyTools: Tool[] = [
  {
    name: "Claude Code",
    use: "my coding agent now; I moved over from Codex and I'm getting a lot more done",
    icon: "siClaude",
    href: "https://claude.com/claude-code",
    accent: "#d97757",
  },
  {
    name: "cmux",
    use: "my preferred terminal",
    image: "/tools/cmux.png",
    href: "https://cmux.com/",
    accent: "#3989f7",
  },
  {
    name: "Zen Browser",
    use: "my preferred browser: open source, with a great UI, sidebar tabs, spaces, and more",
    icon: "siZenbrowser",
    href: "https://zen-browser.app/",
    accent: "#f76f53",
  },
  {
    name: "Kriyan",
    use: "my planner; my AI plans my day with me through its MCP server",
    image: "/logos/kriyan-icon.svg",
    href: "https://kriyan.app/",
    accent: "#6c6c6c",
  },
  {
    name: "Critly",
    use: "my design skills, so my agents build UI that looks and feels right",
    image: "/tools/critly.png",
    href: "https://critly.vercel.app/",
    accent: "#e5533d",
  },
  {
    name: "my skills",
    use: "my agent skill library, linked into every agent I run",
    icon: "siGithub",
    href: "https://github.com/kausthubh-coder/skills",
    accent: "#6c6c6c",
  },
];

const appTools: Tool[] = [
  {
    name: "Convex",
    use: "the best backend-as-a-service I have used",
    icon: "siConvex",
    href: "https://www.convex.dev/",
    accent: "#ee342f",
  },
  {
    name: "PostHog",
    use: "my analytics choice; it is easy to set up and has a generous free tier",
    icon: "siPosthog",
    href: "https://posthog.com/",
    accent: "#f7a501",
  },
  {
    name: "Next.js",
    use: "my framework for web development",
    icon: "siNextdotjs",
    href: "https://nextjs.org/",
    accent: "#111111",
  },
  {
    name: "Tauri",
    use: "my preferred choice for native desktop apps",
    icon: "siTauri",
    href: "https://tauri.app/",
    accent: "#24c8d8",
  },
  {
    name: "Vercel",
    use: "the best way to deploy web apps",
    icon: "siVercel",
    href: "https://vercel.com/",
    accent: "#111111",
  },
  {
    name: "Clerk",
    use: "easy, solid authentication with a good new free tier and great Convex integration",
    icon: "siClerk",
    href: "https://clerk.com/",
    accent: "#6c47ff",
  },
  {
    name: "Autumn",
    use: "the easiest billing service I have tried",
    image: "/tools/autumn.svg",
    href: "https://www.useautumn.com/",
    accent: "#8838ff",
  },
];

const sections = [
  { id: "daily", title: "what I use every day", tools: dailyTools },
  { id: "apps", title: "what I build products with", tools: appTools },
];

const updated = new Date(`${site.workflowUpdated}T12:00:00Z`);
const updatedLabel = updated.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---

<BaseLayout
  title={`Stack + AI workflow | ${site.name}`}
  description="The tools, services, and AI workflow Kausthubh uses to think, build, and ship products."
>
  <main class="page">
    <a class="back-link" href="/"><span aria-hidden="true">&larr;</span> back home</a>

    <header class="tools-intro">
      <h1>tools</h1>
      <p>
        The software, services, and systems I keep reaching for. This is the short version for now; I will add the
        deeper why behind each choice as the stack changes.
      </p>
      <p class="tools-updated">last updated <time datetime={site.workflowUpdated}>{updatedLabel}</time></p>
    </header>

    {
      sections.map((section) => (
        <section class="tools-section" aria-labelledby={`${section.id}-tools-title`}>
          <div class="section-head">
            <h2 id={`${section.id}-tools-title`}>{section.title}</h2>
          </div>
          <ul class="tools-list">
            {section.tools.map((tool) => {
              const icon = iconFor(tool.icon);
              return (
                <li class="tools-item" style={`--tool-accent: ${tool.accent};`}>
                  <span class="tools-icon" aria-hidden="true">
                    {tool.image ? (
                      <img src={tool.image} alt="" width="20" height="20" loading="lazy" />
                    ) : icon ? (
                      <svg viewBox="0 0 24 24">
                        <path d={icon.path} />
                      </svg>
                    ) : null}
                  </span>
                  <div class="tools-copy">
                    <h3>
                      <a href={tool.href} target="_blank" rel="noreferrer">
                        {tool.name}
                      </a>
                    </h3>
                    <p>{tool.use}</p>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <footer class="site-foot">
      <span>still changing, still shipping. <a class="link" href={emailHref}>tell me what I'm missing</a></span>
      <ThemeToggle />
    </footer>
  </main>
</BaseLayout>
