---
import { Image } from "astro:assets";
import ThemeToggle from "../../components/ThemeToggle.astro";
import { site } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProjects, iconFor, morphName, type Project } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      // Every other project, starting from the one after this, so "next" comes first.
      moreProjects: [...projects.slice(index + 1), ...projects.slice(0, index)],
    },
  }));
}

type Props = { project: Project; moreProjects: Project[] };
const { project, moreProjects } = Astro.props;
const pageTitle = `${project.name}: ${project.description} | ${site.name}`;

// The clip leads the page when there is one, since it shows the product doing
// its thing. Otherwise a desktop screenshot leads; phone-only projects show
// their screens side by side, since one phone screen alone reads as a thin strip.
const [first, ...others] = project.previews;
const lead = project.clip || first.mobile ? null : first;
const strip = lead ? others : project.previews;
const [primary, ...secondary] = project.links;
---

<BaseLayout title={pageTitle} description={project.summary}>
  <main class="project-page">
    <a class="back-link" href="/" data-astro-prefetch="hover"><span aria-hidden="true">&larr;</span> back home</a>

    <header class="pd-hero">
      <div class="pd-hero__row">
        <img
          class="pd-hero__logo"
          src={project.logoSrc}
          alt=""
          width="64"
          height="64"
          data-project-mark
          data-morph-name={morphName(project.slug)}
          style={`view-transition-name: ${morphName(project.slug)}; view-transition-class: project-logo;`}
        />
        <div>
          <h1>{project.name}</h1>
          <p class="pd-meta">
            <span class="status" data-status={project.status}>{project.status}</span>
            <span>{project.platforms}</span>
            <span>since {project.year}</span>
            {project.license && <span>{project.license}</span>}
          </p>
        </div>
      </div>
      <p class="pd-lede">{project.description}</p>
      <p class="pd-summary">{project.summary}</p>
      <div class="pd-actions">
        <a class="button" href={primary.href} target="_blank" rel="noreferrer">
          {primary.label} <span aria-hidden="true">&nearr;</span>
        </a>
        {
          secondary.map((link) => (
            <a class="link" href={link.href} target="_blank" rel="noreferrer">
              {link.label}
            </a>
          ))
        }
      </div>
    </header>

    {
      project.clip && (
        <figure class:list={["pd-lead", "pd-clip", { "pd-clip--tall": project.clip.shape === "tall" }]}>
          <div class="shot">
            <video
              src={project.clip.src}
              poster={project.clip.poster}
              width={project.clip.shape === "tall" ? 540 : 1120}
              height={project.clip.shape === "tall" ? 960 : 700}
              autoplay
              muted
              loop
              playsinline
              preload="auto"
              aria-label={`A short clip of ${project.name} in use`}
              data-clip
            />
          </div>
          <figcaption>a quick look, made from real screens</figcaption>
        </figure>
      )
    }

    {
      lead && (
        <figure class="pd-lead">
          <button class="shot" type="button" data-full={lead.fullSrc} aria-label={`Enlarge: ${lead.title}`}>
            <Image
              src={lead.src}
              alt={lead.alt}
              widths={[640, 1280]}
              sizes="(max-width: 700px) 100vw, 640px"
              loading="eager"
              fetchpriority="high"
            />
          </button>
          <figcaption>{lead.caption}</figcaption>
        </figure>
      )
    }

    {
      project.numbers.length > 0 && (
        <dl class="pd-numbers">
          {project.numbers.map((number) => (
            <div>
              <dt>{number.label}</dt>
              <dd>{number.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <section class="pd-section" aria-labelledby="features-title">
      <h2 id="features-title">what it does</h2>
      <ol class="pd-features">
        {
          project.features.map((feature) => (
            <li>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {
      strip.length > 0 && (
        <section class="pd-section" aria-labelledby="shots-title">
          <h2 id="shots-title">{lead ? "more screens" : "inside the app"}</h2>
          <div class="pd-shots" data-shots tabindex="0" aria-label={`${project.name} screenshots, scrolls sideways`}>
            {strip.map((preview) => (
              <figure class="pd-shot">
                <button class="shot" type="button" data-full={preview.fullSrc} aria-label={`Enlarge: ${preview.title}`}>
                  <Image
                    src={preview.src}
                    alt={preview.alt}
                    widths={preview.mobile ? [200, 400] : [480, 960]}
                    sizes={preview.mobile ? "200px" : "(max-width: 620px) 90vw, 480px"}
                    loading="lazy"
                  />
                </button>
                <figcaption>
                  <strong>{preview.title}</strong>
                  <span>{preview.caption}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <section class="pd-section" aria-labelledby="story-title">
      <h2 id="story-title">why I built it</h2>
      <div class="pd-story">
        {project.story.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="pd-section" aria-labelledby="stack-title">
      <h2 id="stack-title">built with</h2>
      <ul class="pd-stack">
        {
          project.stack.map((item) => {
            const icon = iconFor(item.icon);
            return (
              <li>
                {icon ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d={icon.path} />
                  </svg>
                ) : (
                  <i class="pd-stack__letter" aria-hidden="true">
                    {item.name.charAt(0)}
                  </i>
                )}
                <strong>{item.name}</strong>
                <span>{item.why}</span>
              </li>
            );
          })
        }
      </ul>
    </section>

    {
      project.architecture.length > 0 && (
        <details class="pd-section pd-how">
          <summary>how it works</summary>
          <div class="pd-how__body">
            {project.architecture.map((item) => (
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            ))}
          </div>
        </details>
      )
    }

    <nav class="pd-section pd-more" aria-labelledby="more-title">
      <h2 id="more-title">more things I've built</h2>
      <ul>
        {
          moreProjects.map((other) => (
            <li>
              <a href={`/projects/${other.slug}/`} style={`--tilt: ${other.angle}deg;`}>
                <img src={other.logoSrc} alt="" width="48" height="48" />
                <span>{other.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <footer class="site-foot">
      <a class="back-link" href="/"><span aria-hidden="true">&larr;</span> back home</a>
      <ThemeToggle />
    </footer>
  </main>

  <dialog class="lightbox" data-lightbox aria-label="Screenshot">
    <img alt="" data-lightbox-image />
  </dialog>
</BaseLayout>

<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-lightbox]");
    const full = dialog?.querySelector("[data-lightbox-image]");
    const strip = document.querySelector("[data-shots]");
    // Reduced motion: the clip waits for a press instead of playing on its own.
    const clip = document.querySelector("[data-clip]");
    if (clip && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      clip.removeAttribute("autoplay");
      clip.pause();
      clip.controls = true;
    }

    if (!dialog || !full) return;

    // With a mouse, the strip can be dragged sideways like a phone.
    let start = null;
    let moved = false;
    strip?.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      start = { x: event.clientX, scroll: strip.scrollLeft };
      moved = false;
    });
    window.addEventListener("pointermove", (event) => {
      if (!start) return;
      const dx = event.clientX - start.x;
      if (!moved && Math.abs(dx) < 6) return;
      moved = true;
      strip.classList.add("is-dragging");
      strip.scrollLeft = start.scroll - dx;
    });
    window.addEventListener("pointerup", () => {
      start = null;
      strip?.classList.remove("is-dragging");
    });

    let opener = null;
    document.addEventListener("click", (event) => {
      const button = event.target.closest("[data-full]");
      if (!button) return;
      if (moved) {
        moved = false;
        return;
      }
      opener = button;
      full.src = button.dataset.full;
      full.alt = button.querySelector("img")?.alt ?? "";
      dialog.showModal();
    });
    dialog.addEventListener("click", () => dialog.close());
    dialog.addEventListener("close", () => opener?.focus());
  })();
</script>
