---
import "../styles/global.css";
import { site } from "../data/site";

type Props = {
  title?: string;
  description?: string;
  introBoot?: boolean;
  noindex?: boolean;
};

const {
  title = `${site.name} | building cool stuff`,
  description = site.description,
  introBoot = false,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const shareImage = new URL(site.shareImage, site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdfdfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Before first paint, so a saved theme never flashes the other one.
      (() => {
        try {
          const theme = localStorage.getItem("kausthubh:theme");
          if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {introBoot && <link rel="preload" href="/logo.webp" as="image" type="image/webp" fetchpriority="high" />}
    <link rel="preload" href="/fonts/sora-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    {
      introBoot && (
        <script is:inline>
          (() => {
            const storageKey = "kausthubh:intro:v5";
            const doc = document.documentElement;
            const isReload = () => {
              const nav = performance.getEntriesByType("navigation")[0];
              return nav && nav.type === "reload";
            };
            const readPlayed = () => {
              try {
                return window.sessionStorage.getItem(storageKey) === "1";
              } catch {
                return false;
              }
            };
            const writePlayed = () => {
              try {
                window.sessionStorage.setItem(storageKey, "1");
              } catch {
                return;
              }
            };

            if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
              doc.dataset.introState = "done";
              return;
            }

            if (readPlayed() && !isReload()) {
              doc.dataset.introState = "done";
              return;
            }

            // Coming back from elsewhere on the site is not a first impression,
            // and the intro would fight the return transition.
            const arrivedFrom = window.navigation?.activation?.from;
            if (arrivedFrom && arrivedFrom.url !== location.href) {
              writePlayed();
              doc.dataset.introState = "done";
              return;
            }

            writePlayed();
            window.__kausthubhIntroStarted = true;
            doc.dataset.introState = "running";
            doc.dataset.introReady = "true";
          })();
        </script>
      )
    }
    <script is:inline>
      (() => {
        const returnKey = "kausthubh:nav:return";
        const asUrl = (value) => new URL(value, location.href);
        const slugOf = (value) => {
          const match = asUrl(value).pathname.match(/^\/projects\/([^/]+)\/?$/);
          return match ? match[1] : null;
        };
        const depthOf = (value) => {
          if (slugOf(value)) return 2;
          return asUrl(value).pathname.replace(/\/+$/, "") ? 1 : 0;
        };
        const tagDirection = (transition, from, to) => {
          if (!transition || !from || !to) return;
          transition.types?.add?.(depthOf(to) < depthOf(from) ? "nav-back" : "nav-forward");
        };
        const onScreen = (element) => {
          const rect = element.getBoundingClientRect();
          return rect.bottom > 0 && rect.top < window.innerHeight;
        };

        window.addEventListener("pageswap", (event) => {
          const from = event.activation?.from?.url;
          const to = event.activation?.entry?.url;
          if (!from || !to) return;
          tagDirection(event.viewTransition, from, to);

          const slug = slugOf(from);
          if (!slug || depthOf(to) !== 0) return;

          // The hero mark anchors the morph home. Once it is scrolled out of
          // view it would streak across the screen, so fall back to a fade.
          const mark = document.querySelector("[data-project-mark]");
          const morph = Boolean(mark && onScreen(mark));
          if (mark && !morph) mark.style.viewTransitionName = "none";
          try {
            sessionStorage.setItem(returnKey, JSON.stringify({ slug, morph }));
          } catch {
            return;
          }
        });

        window.addEventListener("pagereveal", (event) => {
          const activation = window.navigation?.activation;
          tagDirection(event.viewTransition, activation?.from?.url, activation?.entry?.url);

          // A restored page may still be carrying a mark we suppressed on the
          // way out, so hand the shared name back before anything paints.
          const mark = document.querySelector("[data-project-mark]");
          if (mark) mark.style.viewTransitionName = mark.dataset.morphName;

          let detail = null;
          try {
            const raw = sessionStorage.getItem(returnKey);
            sessionStorage.removeItem(returnKey);
            detail = raw ? JSON.parse(raw) : null;
          } catch {
            detail = null;
          }
          if (!detail) return;
          document.dispatchEvent(
            new CustomEvent("portfolio:return", {
              detail: { ...detail, transition: event.viewTransition ?? null },
            }),
          );
        });
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
